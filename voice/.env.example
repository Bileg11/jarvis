# JARVIS VOICE тохиргоо — энэ файлыг .env нэрээр хуулж бөглөнө
# cp .env.example .env

# Аль провайдер ашиглах: edge (үнэгүй) эсвэл eleven (ElevenLabs)
JARVIS_VOICE_PROVIDER=edge

# ── ElevenLabs (заавал биш) ───────────────────────────────────────
# elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=

# Хэд хэдэн хоолой: нэр:ID,нэр:ID
# Нэрийг нь өөрийн дуртайгаар солиорой — voice.html дээр ингэж харагдана.
ELEVENLABS_VOICES=bilguun:ZY2eShwTXxMs91i4OIqr,sokoo:KQhNCZcXa4AKEt3GoAdo

# Анхдагч хоолой (хоосон бол дээрх жагсаалтын эхнийх)
ELEVENLABS_VOICE_ID=ZY2eShwTXxMs91i4OIqr

# ElevenLabs дээр ажилласан загварын ID (жишээ: eleven_v3, eleven_multilingual_v2).
# Сайт дээрх "Eleven v4" гэх мэт нэр ≠ API model_id. Docs-оос яг ID-г нь хар.
ELEVENLABS_MODEL=eleven_v3
