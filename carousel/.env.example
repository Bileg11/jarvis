# ---- Gemini (free tier) : https://aistudio.google.com/apikey ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# blue | green
THEME=blue

# ---- Meta Graph API ----
# Нэрийг хоёр янзаар дэмжинэ, аль нь ч болно.
# Page-ийн урт хугацааны access token
META_ACCESS_TOKEN=
# FB_PAGE_TOKEN_AI_OFFICE=

# Facebook Page ID
FB_PAGE_ID=
# FACEBOOK_PAGE_ID=

# Instagram Business Account ID (Page-тэй холбоотой)
IG_USER_ID=
# INSTAGRAM_BUSINESS_ID=

META_API_VERSION=v21.0

# ---- Зураг hosting ----
# ХООСОН ҮЛДЭЭ. Facebook зургийг шууд хүлээж авдаг тул hosting хэрэггүй.
# Зөвхөн өөрийн hosting ашиглах бол бөглөнө (зурагнууд JPEG байх ёстой).
# PUBLIC_MEDIA_BASE=

# ---- Local Chrome (optional override) ----
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
